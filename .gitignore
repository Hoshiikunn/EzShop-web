# ================= 依赖 =================
node_modules/

# ================= 构建产物 =================
dist/
dist-ssr/
.vite/

# uni-app（微信小程序编译产物）
unpackage/

# ================= 微信小程序 =================
# 开发者工具"私有配置"（个人 AppID 调试参数、编译模式），因人而异，不入库
project.private.config.json
# 注意：project.config.json 是项目公共配置，必须提交，不要误加进来

# miniprogram-ci 上传密钥（CI 发体验版/正式版用，等同密码，严禁入库）
*.key

# ================= 测试与质量工具 =================
coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ================= 环境变量 =================
# 环境变量默认不入库，避免误提交本机配置或密钥
.env
.env.*
!.env.example

# ================= 日志 =================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================= 编辑器 / IDE =================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code：忽略个人配置，但保留团队共享项
.vscode/*
!.vscode/extensions.json
# 如需统一 prettier/eslint 格式化规则，放开下一行
# !.vscode/settings.json

.history/

# Vim
*.swp
*.swo

# ================= 操作系统 =================
.DS_Store
Thumbs.db
desktop.ini

# ================= 其他 =================
*.bak
